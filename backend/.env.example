# Vidura v2 server configuration. Every value is read once at start-up and
# validated; the server refuses to start with an unsafe combination.

# production (default) or development.
VIDURA_ENV=production
# Listen address.
VIDURA_ADDR=:8790
# Holds vidura.db (SQLite). Mount a volume here.
VIDURA_DATA_DIR=/data
# The three public addresses, each on its own host. They must share one
# registrable domain (the session cookie is SameSite=Lax) and use https in
# production. Only the two portals may make state-changing calls.
VIDURA_API_URL=https://api-vidura.prabhavalabs.com
VIDURA_ADMIN_URL=https://admin-vidura.prabhavalabs.com
VIDURA_CLIENT_URL=https://vidura.prabhavalabs.com
# Signs short-lived sign-in state. Generate with: openssl rand -hex 32
VIDURA_SECRET=
# Comma-separated owner emails. Always superusers; can't be demoted, disabled
# or deleted from the admin portal.
VIDURA_SUPERUSER_EMAILS=
# Set to true when a reverse proxy (nginx) sits in front, so client addresses
# come from X-Forwarded-For.
VIDURA_TRUST_PROXY=true
# Optional proxy for yt-dlp caption downloads (YouTube blocks most datacenter
# addresses), e.g. http://user:pass@residential-proxy:port
VIDURA_YOUTUBE_PROXY=

# Google OAuth client (Google Cloud Console → Credentials). Add this
# authorized redirect URI: <VIDURA_API_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only: sign in an allowed email with VIDURA_DEV_PASSWORD
# (8+ characters) instead of Google. Refused unless VIDURA_ENV=development.
VIDURA_DEV_LOGIN=false
VIDURA_DEV_PASSWORD=
